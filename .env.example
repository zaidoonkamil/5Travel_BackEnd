PORT=1500
NODE_ENV=development

JWT_SECRET=change_me_to_a_long_random_string

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=five_travel
DB_PORT=3306
# true = يعدل الجداول تلقائياً حسب الموديلات (للتطوير فقط)
DB_SYNC_ALTER=false

CORS_ORIGINS=http://localhost:3000

# Hermeseus HAPI v3 — test credentials start with cid_test_, live with cid_live_
HERMES_BASE_URL=https://api.hermeseus.com/v3/HAPI
HERMES_CLIENT_ID=
HERMES_CLIENT_SECRET=

# أول أدمن ينشأ تلقائياً عند تشغيل السيرفر
ADMIN_EMAIL=admin@fivetravel.com
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# OTPIQ — WhatsApp verification codes (same as wasalni). Without a key in development the code is printed in the server console.
OTPIQ_API_KEY=
OTPIQ_PROVIDER=whatsapp
OTPIQ_BASE_URL=https://api.otpiq.com/api
OTPIQ_TIMEOUT_MS=15000
# Optional, only if OTPIQ support asks for a specific sender/template:
OTPIQ_WHATSAPP_ACCOUNT_ID=
OTPIQ_WHATSAPP_PHONE_ID=
OTPIQ_TEMPLATE_NAME=
OTPIQ_SENDER_ID=
